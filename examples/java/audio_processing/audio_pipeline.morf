# Morflow Audio DSP Pipeline (.morf)

import audio_essentials.latest

accept $input_audio
accept $sample_rate = 44100

# Direct chained DSP processing with inline multi-channel loop
$input_audio
    >> to_audio(sample_rate=$sample_rate)
    >> resample(to_rate=48000)
    >> normalize(target_peak=0.95)
    >> each ($channel) {
        $channel
            >> biquad_filter(type="highpass", freq=30.0, sample_rate=48000)
            >> compressor(threshold_db=-12.0, ratio=3.0)
    }
    >> stereo_widen(width=1.2)
    >> limiter(ceiling_db=-0.1)
    >> to_wav
    >> emit
